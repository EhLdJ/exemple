# Configuration de l'environnement
NODE_ENV=development
PORT=3000

# Configuration de la base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_emprunts
DB_USER=postgres
DB_PASSWORD=password

# Clés de sécurité
JWT_SECRET=your_super_secret_jwt_key_here_make_it_very_long_and_random
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=another_very_long_secret_for_refresh_tokens

# Configuration SMS (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Configuration Email (pour les boutiquiers)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME="Gestion d'Emprunts"

# URLs frontend (pour CORS)
FRONTEND_URL=http://localhost:3000
MOBILE_URL=http://10.0.2.2:3000

# Configuration QR Code
QR_EXPIRY_MINUTES=5
QR_SECRET_KEY=your_qr_signature_secret_key

# Configuration de l'upload
UPLOAD_MAX_SIZE=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# Configuration rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuration Redis (optionnel, pour le cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Configuration logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Configuration backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=24
BACKUP_RETENTION_DAYS=30